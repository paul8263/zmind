{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zmind",
  "version": "0.1.0",
  "identifier": "com.zmind.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zmind",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Zmind",
    "copyright": "Copyright © 2026 Zmind",
    "category": "Productivity",
    "shortDescription": "A local-first mind map desktop app",
    "longDescription": "Zmind is a lightweight, local-first mind map desktop app for Windows with keyboard-first editing, automatic layout, themes, and local file storage.",
    "fileAssociations": [
      {
        "ext": ["zmind"],
        "name": "Zmind Document",
        "description": "Zmind mind map document",
        "mimeType": "application/x-zmind"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
